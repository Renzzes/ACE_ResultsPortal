# ACE Results Portal — environment template
# Copy to `.env` for local/runtime use. NEVER commit real secrets.
# Values below are placeholders only.

# --- Process ---
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=info
BASE_PATH=/

# Public browser origins (comma-separated). Include your real public HTTPS origin in production.
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Optional runtime roots (Windows production often sets these explicitly)
ACERPTS_ROOT=
RESULT_STORAGE_ROOT=./var/result-files
RESULT_MAX_FILE_BYTES=

# --- Auth ---
# Use a long random string (>= 32 characters) in real deployments
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- Portal SQL Server (application database) ---
# Do NOT set DB_DATABASE to LiveDB_ACE or other hospital system databases.
DB_SERVER=sql.example.local
DB_INSTANCE=
DB_PORT=1433
DB_USER=ace_results_portal_app
DB_PASSWORD=replace-me
DB_DATABASE=ACE_ResultsPortal
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000

# --- HIS / hospital DB (read-only verification) ---
# Dedicated HIS login required in production (fail-closed).
HOSPITAL_DB_DATABASE=YourHospitalReadonlyDbName
HIS_DB_USER=ace_results_his_readonly
HIS_DB_PASSWORD=replace-me
# Optional overrides (otherwise host/port may follow portal DB_* where allowed by code)
HIS_DB_SERVER=
HIS_DB_PORT=
HIS_DB_DATABASE=

# --- SMTP / portal email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-me
PORTAL_EMAIL_FROM=ACE Results Portal <noreply@example.com>

# --- Optional first-boot bootstrap accounts (local/dev only; remove or rotate in production) ---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-me-strong-password
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=User
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

STAFF_BOOTSTRAP_USERNAME=staff
STAFF_BOOTSTRAP_PASSWORD=replace-me-strong-password
STAFF_BOOTSTRAP_ROLE=medical_records

DOCTOR_BOOTSTRAP_USERNAME=doctor
DOCTOR_BOOTSTRAP_PASSWORD=replace-me-strong-password

PATIENT_BOOTSTRAP_USERNAME=patient
PATIENT_BOOTSTRAP_PASSWORD=replace-me-strong-password
PATIENT_BOOTSTRAP_HIS_ID=EXAMPLE-HIS-ID
PATIENT_BOOTSTRAP_FIRST_NAME=Sample
PATIENT_BOOTSTRAP_LAST_NAME=Patient

# --- Front-end / tooling (optional) ---
VITE_PORT=8080
API_PORT=5000

# --- Optional appointment scheduler DB (if enabled) ---
# SCHEDULER_DB_DATABASE=
# SCHEDULER_DB_SERVER=
# SCHEDULER_DB_USER=
# SCHEDULER_DB_PASSWORD=
# SCHEDULER_PATIENT_HIS_ID_COLUMN=
